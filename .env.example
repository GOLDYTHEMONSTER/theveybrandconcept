# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Rate limiting (Upstash Redis, free tier) ---
# If unset, rate limiting automatically falls back to the Postgres
# rate_limit_events table (slower, but never silently disabled).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (test mode) ---
# dashboard.stripe.com/test/apikeys -- if unset, storefront checkout
# returns a 503 "not configured" error rather than completing an
# unpaid order.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# dashboard.stripe.com/test/webhooks (add endpoint: <your-domain>/api/webhooks/stripe,
# events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded)
# or `stripe listen --forward-to localhost:4000/api/webhooks/stripe` for local dev,
# which prints a temporary whsec_... for that session.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Shipping webhook (simulated -- no real logistics provider wired up yet) ---
# Shared secret the simulated carrier webhook (app/api/webhooks/shipping)
# checks for in the x-webhook-secret header. Defaults to
# "sandbox-shipping-secret" if unset; only override to test with a
# non-default value.
SHIPPING_WEBHOOK_SECRET=sandbox-shipping-secret
