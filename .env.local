# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from your Supabase project dashboard:
# 1. Go to https://supabase.com and sign in
# 2. Open your project
# 3. Settings > API > Project URL → copy to NEXT_PUBLIC_SUPABASE_URL
# 4. Settings > API > Project API keys > anon public → copy to NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Settings > API > Project API keys > service_role (⚠️ NEVER share) → copy to SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# Rate Limiting — Upstash Redis (Optional for v1)
# ============================================================================
# If empty, rate limiting automatically falls back to Postgres rate_limit_events table.
# To add Redis later:
# 1. Go to https://upstash.com (sign up for free tier)
# 2. Create a new database in the same region as Supabase
# 3. Copy REST Endpoint → UPSTASH_REDIS_REST_URL
# 4. Copy REST Token → UPSTASH_REDIS_REST_TOKEN

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
